# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de UNA tienda. Copiar a .env para desarrollo local
# (.env está en .gitignore). En Railway se cargan en la pestaña Variables del servicio.
# Obligatorias: las que no tienen valor por defecto en application.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Tienda ───
TIENDA_NOMBRE=Mi Tienda
TIENDA_FRONTEND_URL=https://mitienda.com.ar
TIENDA_API_URL=https://api.mitienda.com.ar
TIENDA_CORS_ORIGENES=https://mitienda.com.ar,https://www.mitienda.com.ar
TIENDA_MONEDA=ARS
TIENDA_ENVIO_DOMICILIO_HABILITADO=true
TIENDA_ENVIO_RETIRO_HABILITADO=true
TIENDA_ENVIO_COSTO_FIJO=0
TIENDA_PEDIDOS_HORAS_VENCIMIENTO=48
# Dominio padre para que el front lea la cookie XSRF-TOKEN cuando la API está en un subdominio
TIENDA_COOKIES_DOMINIO=mitienda.com.ar
TIENDA_COOKIES_SAME_SITE=lax
# Header con la IP real del cliente puesto por el proxy de delante (límite de intentos de login por IP).
# CF-Connecting-IP SOLO si el servidor acepta tráfico únicamente desde Cloudflare (firewall con sus rangos, ver
# docs/despliegue-oracle-coolify.md); si no, el cliente podría inventarlo. En Railway dejarlo vacío.
TIENDA_PROXY_HEADER_IP_CLIENTE=
# Primer administrador (solo se usa si la base no tiene usuarios). Borrarlas después del primer deploy.
TIENDA_ADMIN_INICIAL_USUARIO=
TIENDA_ADMIN_INICIAL_CLAVE=

# ─── Base de datos (en Railway: SPRING_DATASOURCE_URL/USERNAME/PASSWORD, ver README) ───
PGHOST=localhost
PGPORT=5432
PGDATABASE=tiendas
PGUSER=tiendas
PGPASSWORD=
DB_POOL_MAX=10

# ─── Mercado Pago (credenciales de la cuenta de la tienda) ───
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo desarrollo (perfil local, por defecto true): aprueba los pedidos sin Mercado Pago.
# Poner false para probar con el sandbox real. Fuera del perfil local la app no arranca si es true.
MP_SIMULADO=true

# ─── Almacenamiento de archivos: LOCAL (desarrollo) o S3 (producción) ───
ALMACENAMIENTO_TIPO=LOCAL
ALMACENAMIENTO_LOCAL_DIRECTORIO=./datos/archivos
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, región auto. Bucket PRIVADO.
ALMACENAMIENTO_S3_ENDPOINT=
ALMACENAMIENTO_S3_REGION=auto
ALMACENAMIENTO_S3_BUCKET=
ALMACENAMIENTO_S3_ACCESS_KEY=
ALMACENAMIENTO_S3_SECRET_KEY=
ALMACENAMIENTO_S3_PATH_STYLE=false

# ─── Cupones de descuento (módulo opcional) ───
# true  → el panel muestra la sección Descuentos (GET /api/v1/tienda → modulos.descuentos = true) y el
#         checkout acepta códigos de descuento.
# false → no hay endpoints de administración de cupones y el checkout rechaza cualquier código.
# Por defecto: false (en el perfil local: true).
DESCUENTOS_HABILITADA=false

# ─── Envíos por zona (módulo opcional) ───
# true  → el dueño carga zonas de envío (por código postal) con precio y plazo, retiro y "envío gratis
#         desde $X" en el panel; el checkout cobra el envío según el código postal del cliente
#         (GET /api/v1/tienda → modulos.envios = true).
# false → el envío usa TIENDA_ENVIO_COSTO_FIJO y los flags de domicilio/retiro de arriba.
# Por defecto: false (en el perfil local: true).
ENVIOS_HABILITADA=false

# ─── Personalización de productos (módulo opcional, ej. grabado) ───
# true  → cada producto (salvo los servicios) ofrece una personalización con un precio único por unidad que el
#         dueño edita en el panel (nombre, precio y texto de ayuda). El checkout lo suma en el servidor.
#         GET /api/v1/tienda → modulos.personalizacion = true.
# false → el checkout rechaza los productos personalizados. Por defecto: false (en el perfil local: true).
PERSONALIZACION_HABILITADA=false

# ─── Correo Argentino (API MiCorreo), requiere ENVIOS_HABILITADA=true ───
# true → las zonas de envío pueden ser de tipo "Correo Argentino": precio y plazo los cotiza el Correo (a domicilio
#        y a sucursal) y desde el panel se dan de alta los envíos en MiCorreo.
# Las credenciales de la API se piden al Correo (formulario de integración de MiCorreo), una por ambiente.
# El número de cliente está en MiCorreo > Mi Perfil > Datos de facturación ("Nro cliente").
CORREO_ARGENTINO_HABILITADA=false
# TEST: https://apitest.correoargentino.com.ar/micorreo/v1  ·  Producción: https://api.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_URL=https://api.correoargentino.com.ar/micorreo/v1
CORREO_ARGENTINO_USUARIO=
CORREO_ARGENTINO_CLAVE=
CORREO_ARGENTINO_NUMERO_CLIENTE=
# Código postal del domicilio de remitente cargado en MiCorreo (desde donde se despacha)
CORREO_ARGENTINO_CODIGO_POSTAL_ORIGEN=
# Solo perfil local: cotiza con precios inventados, sin llamar al Correo (por defecto true en local)
CORREO_ARGENTINO_SIMULADO=false

# ─── Zipnova (API de envíos), requiere ENVIOS_HABILITADA=true
# true → las zonas de envío pueden ser de tipo "Zipnova": precio, plazo y sucursales los cotiza Zipnova con varios
#        transportes (Andreani, Correo Argentino, OCA…) y desde la venta se crea el envío y se baja la etiqueta.
# Credenciales: panel de Zipnova > Configuración > Integraciones > Gestionar credenciales y webhooks (token y secret).
# Los envíos se despachan desde el origen por defecto de la cuenta (Zipnova > Configuración > Orígenes por defecto).
ZIPNOVA_HABILITADA=false
ZIPNOVA_URL=https://api.zipnova.com.ar/v2
ZIPNOVA_API_TOKEN=
ZIPNOVA_API_SECRET=
# Opcionales: sin cuenta se usa la única de las credenciales; sin origen, el origen por defecto de la cuenta
ZIPNOVA_CUENTA_ID=
ZIPNOVA_ORIGEN_ID=
# Solo perfil local: cotiza y crea envíos inventados, sin llamar a Zipnova (por defecto true en local)
ZIPNOVA_SIMULADO=false
# Avisos de Zipnova (webhook, tópicos "status" y "shipment"): actualizan solos el estado del envío de cada venta.
# Secreto de al menos 32 caracteres (ej. `openssl rand -hex 32`); en Zipnova > Integraciones > Crear webhook va la URL
# https://<api de la tienda>/api/v1/webhooks/zipnova/<secreto>. Vacío = los avisos se rechazan.
ZIPNOVA_WEBHOOK_SECRETO=

# ─── Facturación electrónica ARCA (módulo opcional) ───
# true  → se activan los endpoints de facturación y el panel muestra la tarjeta de Facturación
#         (GET /api/v1/tienda → modulos.facturacion = true). Requiere completar las variables de abajo.
# false → el módulo no existe en esta instancia (endpoints 404) y el panel oculta la tarjeta.
# Por defecto: false.
FACTURACION_HABILITADA=false
FACTURACION_EMISOR_CUIT=
FACTURACION_EMISOR_RAZON_SOCIAL=
FACTURACION_EMISOR_CONDICION_IVA=MONOTRIBUTISTA
FACTURACION_EMISOR_DOMICILIO=
FACTURACION_EMISOR_INGRESOS_BRUTOS=
FACTURACION_EMISOR_INICIO_ACTIVIDADES=
FACTURACION_PUNTO_VENTA=1
FACTURACION_TIPO_COMPROBANTE=FACTURA_C
FACTURACION_ALICUOTA_IVA_DEFAULT=IVA_21
FACTURACION_PDF_LOGO=
FACTURACION_PDF_COLOR_ACENTO=#4F46E5
FACTURACION_AFRELAY_URL=
FACTURACION_AFRELAY_TOKEN=

# ─── Emails (módulo opcional, enviados con Resend: resend.com) ───
# true  → al aprobarse un pago se envía la confirmación al cliente y el aviso de venta a EMAIL_ADMIN.
#         Los emails pasan por una cola en la base con reintentos (no se pierden si Resend está caído).
#         GET /api/v1/tienda → modulos.email = true.
# false → no se envían emails. Por defecto: false.
# Requisitos en Resend: verificar el dominio de la tienda (registros DNS SPF/DKIM) y crear una API key
# con permiso "Sending access" restringida a ese dominio.
EMAIL_HABILITADA=false
# Remitente con el dominio verificado en Resend
EMAIL_REMITENTE=Mi Tienda <ventas@mitienda.com.ar>
# Destinatarios del aviso de venta, separados por coma
EMAIL_ADMIN=admin@mitienda.com.ar
# A dónde llegan las respuestas del cliente a la confirmación (vacío = primera dirección de EMAIL_ADMIN)
EMAIL_RESPONDER_A=
EMAIL_RESEND_API_KEY=
